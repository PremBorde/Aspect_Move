{
  "expo": {
    "name": "AspectMove",
    "slug": "reactApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app_logo_1785056480414.png",
    "scheme": "reactapp",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.prem9880.reactApp"
    },
    "android": {
      "package": "com.prem9880.reactApp",
      "adaptiveIcon": {
        "backgroundColor": "#F8FAFC",
        "foregroundImage": "./assets/images/app_logo_1785056480414.png"
      }
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/app_logo_1785056480414.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F8FAFC"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "3e9b6f47-c6ae-4b25-8fdf-7a3ca9f3c8ce"
      }
    }
  }
}
